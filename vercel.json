{
  "rewrites": [
    {
      "source": "/claude-interviews",
      "destination": "https://claude-interviews.vercel.app/claude-interviews"
    },
    {
      "source": "/claude-interviews/",
      "destination": "https://claude-interviews.vercel.app/claude-interviews"
    },
    {
      "source": "/claude-interviews/:path+/",
      "destination": "https://claude-interviews.vercel.app/claude-interviews/:path+"
    },
    {
      "source": "/claude-interviews/:path*",
      "destination": "https://claude-interviews.vercel.app/claude-interviews/:path*"
    },
    {
      "source": "/pdf",
      "destination": "/gonzalo-enei.pdf"
    }
  ],
  "headers": [
    {
      "source": "/pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Gonzalo Enei.pdf\""
        }
      ]
    }
  ]
}
